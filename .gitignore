# --- Benchmark Results ---
# NOTE: no blanket `*.json` rule — it silently swallowed legitimate config
# and made the eval data look "checked in" when nothing was. Generated
# outputs and downloaded datasets are ignored by directory instead.
/results/
/bench_results/
*.csv
*.parquet
# Downloaded eval datasets are large (LoCoMo alone is ~240MB). Fetch them
# with `make download-eval-data`; never commit them.
benchmarks/cognitive_eval/data/
# Generated benchmark outputs (result JSON, predicted answers, scratch DBs).
benchmarks/**/results/
benchmarks/memory_benchmarks/datasets/
mem0_eval_db/
# Machine-local client settings.
.claude/settings.local.json

